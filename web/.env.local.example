# Supabase -> Project Settings -> API. Both are safe in the browser: the anon key
# can only do what RLS allows, and RLS only lets active team members in.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the time zone dates are shown in (default Asia/Karachi)
# NEXT_PUBLIC_TEAM_TIME_ZONE=Asia/Karachi

# Gmail sending and sync (docs/GMAIL.md). Server-only: never prefix these with NEXT_PUBLIC_.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MAIL_TOKEN_KEY=      # 32 random bytes, base64; encrypts Gmail tokens
# MAILER_SECRET=       # lets the mail worker into the mail functions; its hash is stored in the database
# CRON_SECRET=         # pg_cron sends it to /api/mail/tick
