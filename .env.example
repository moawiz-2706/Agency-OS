# Copy to .env and fill in. Never commit .env.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "service_role" / secret key. Server-side only. Bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud -> APIs & Services -> Credentials (restrict it to "Places API (New)")
GOOGLE_PLACES_API_KEY=

# Optional: identify your website checker politely
# AGENCYOS_USER_AGENT=AgencyOS-LeadAudit/0.1 (+mailto:you@yourdomain.com)

# CRM team (scripts/setup-team.mjs). First email = owner, the rest are partners.
TEAM_EMAILS=you@youragency.com,partner@youragency.com
# Optional display names, same order
TEAM_NAMES=
# scripts/import-leads.mjs --assign=region: the owner gets these states/provinces, the partner the rest
ASSIGN_REGIONS_A=ON,AB,BC,AZ,TX
