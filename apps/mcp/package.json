{
  "name": "@agencyos/mcp",
  "version": "0.2.0",
  "description": "AgencyOS MCP server: thin tool wrappers over @agencyos/core",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agencyos-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --conditions=source src/index.ts",
    "start": "node dist/index.js",
    "audit-leads": "tsx --conditions=source src/cli/audit-leads.ts"
  },
  "dependencies": {
    "@agencyos/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
